{
  "name": "backend",
  "version": "1.0.0",
  "description": "Example tasks API with PostgreSQL and Drizzle",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --legacy-watch index.js",
    "migrate": "node migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --host=0.0.0.0 --port=4983",
    "test": "node --test"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "nodemon": "3.1.14"
  }
}
